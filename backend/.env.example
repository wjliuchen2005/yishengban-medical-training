# MySQL 8.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=yishengban

# JWT: replace this value before production deployment
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OpenAI-compatible LLM provider (Zhipu GLM / DeepSeek, etc.)
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.3-flash
LLM_REASONING_EFFORT=high
LLM_CHAT_REASONING_EFFORT=low

# Xiaomi MiMo V2.5 TTS (key must stay in backend/.env only)
MIMO_API_KEY=replace_with_your_mimo_api_key
MIMO_TTS_ENABLED=true
MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_TIMEOUT_SECONDS=30

# Voice input (same MiMo key; no browser credentials and no public audio uploads)
MIMO_ASR_BASE_URL=https://api.xiaomimimo.com/v1
VOICE_ASSESSMENT_MODEL=mimo-v2.5
# Conservative daily-quota reservations, not exact provider billing
MIMO_ASR_RMB_PER_HOUR=0.5
MIMO_AUDIO_INPUT_RMB_PER_MILLION=1
MIMO_AUDIO_OUTPUT_RMB_PER_MILLION=2

# Rating resilience
RATING_REQUEST_TIMEOUT_SECONDS=60
RATING_TASK_STALE_SECONDS=90

# Comma-separated browser origins. Add your HTTPS domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
