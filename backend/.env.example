# MySQL 8.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=yishengban

# JWT: replace this value before production deployment
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OpenAI-compatible LLM provider (Zhipu GLM / DeepSeek, etc.)
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.3-flash
LLM_REASONING_EFFORT=high
LLM_CHAT_REASONING_EFFORT=low

# Rating resilience
RATING_REQUEST_TIMEOUT_SECONDS=60
RATING_TASK_STALE_SECONDS=90

# Comma-separated browser origins. Add your HTTPS domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
